            case 'versus_transition':
                return <VersusTransitionView onFinish={handleVersusFinish} />;

            case 'timer':
                return <CountdownTimer team={activeTeam} onComplete={() => setGameState('game')} />;

            case 'game':
                if (activeGame.type === 'timestop') {
                    return <TimeStopGame game={activeGame} onResult={handleGameResult} />;
                }
                if (activeGame.type === 'chartquiz') {
                    return <ChartQuizGame game={activeGame} onResult={handleGameResult} />;
                }
                if (activeGame.type === 'collective') {
                    return <CollectivePunishmentGame game={activeGame} teams={teams} onResult={handleGameResult} />;
                }
                // Standard games (Lists & Challenges)
                return <GameEngine game={activeGame} activeTeam={activeTeam} teams={teams} onResult={handleGameResult} onSkip={handleSkip} />;

            case 'punishment':
                return <PunishmentView type={punishmentType} onNext={() => { playClick(); setGameState('hub'); }} />;

            default:
                return null;
        }
    };

    return (
        <div className="drunk-bg min-h-[100dvh] font-sans">
            <GlobalStyles />
            <button onClick={toggleMute} className="fixed top-4 right-4 z-50 p-2 bg-black/40 rounded-full text-white/70 hover:text-white">
                {muted ? <VolumeX size={24} /> : <Volume2 size={24} />}
