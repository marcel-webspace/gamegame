const CountdownTimer = ({ team, onComplete }) => {
    const [count, setCount] = useState(3);
    useEffect(() => {
        if (count > 0) {
            SoundEngine.tock();
            const timer = setTimeout(() => setCount(count - 1), 1000);
            return () => clearTimeout(timer);
        } else {
            SoundEngine.click();
            onComplete();
        }
    }, [count, onComplete]);

    let bgClass = '';
    let text = '';
    
    if (team === 'both') {
        bgClass = 'bg-gradient-to-r from-red-600 to-blue-600';
        text = 'Beide Teams machen sich bereit!';
    } else {
        bgClass = team === 'red' ? 'bg-red-600' : 'bg-blue-600';
        text = `Team ${team === 'red' ? 'Rot' : 'Blau'} macht sich bereit!`;
    }

    return (
        <div className={`min-h-[100dvh] flex flex-col items-center justify-center text-white relative overflow-hidden transition-colors duration-500 ${bgClass}`}>
            <div className="absolute inset-0 bg-black/20"></div>
            <div className="relative z-10 text-center">
                <h2 className="text-3xl sm:text-4xl font-bold text-white mb-8 uppercase tracking-widest px-4 drop-shadow-md">
                    {text}
                </h2>
                <div className="text-[10rem] sm:text-[15rem] font-display text-white leading-none drop-shadow-[0_10px_20px_rgba(0,0,0,0.5)] scale-110 transform transition-all animate-breathe">
                    {count}
                </div>
            </div>
        </div>
    );
};

