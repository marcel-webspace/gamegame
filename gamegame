// --- AUDIO ENGINE ---
const SoundEngine = {
    ctx: null,
    muted: false,
    beatInterval: null,

    init: () => {
        if (!SoundEngine.ctx) {
            SoundEngine.ctx = new (window.AudioContext || window.webkitAudioContext)();
        }
        if (SoundEngine.ctx.state === 'suspended') {
            SoundEngine.ctx.resume();
        }
    },

    playTone: (freq, type, duration, vol = 0.1, time = 0) => {
        if (SoundEngine.muted || !SoundEngine.ctx) return;
        const osc = SoundEngine.ctx.createOscillator();
        const gain = SoundEngine.ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, SoundEngine.ctx.currentTime + time);
        gain.gain.setValueAtTime(vol, SoundEngine.ctx.currentTime + time);
        gain.gain.exponentialRampToValueAtTime(0.01, SoundEngine.ctx.currentTime + time + duration);
        osc.connect(gain);
        gain.connect(SoundEngine.ctx.destination);
        osc.start(SoundEngine.ctx.currentTime + time);
        osc.stop(SoundEngine.ctx.currentTime + time + duration);
    },

    playNoise: (duration, vol = 0.2) => {
        if (SoundEngine.muted || !SoundEngine.ctx) return;
        const bufferSize = SoundEngine.ctx.sampleRate * duration;
        const buffer = SoundEngine.ctx.createBuffer(1, bufferSize, SoundEngine.ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
            data[i] = Math.random() * 2 - 1;
        }
        const noise = SoundEngine.ctx.createBufferSource();
        noise.buffer = buffer;
        const gain = SoundEngine.ctx.createGain();
        const filter = SoundEngine.ctx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.value = 1000;

        gain.gain.setValueAtTime(vol, SoundEngine.ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, SoundEngine.ctx.currentTime + duration);
        
        noise.connect(filter);
        filter.connect(gain);
        gain.connect(SoundEngine.ctx.destination);
        noise.start();
    },

    startBeat: (bpm = 120) => {
        if (SoundEngine.beatInterval) clearInterval(SoundEngine.beatInterval);
        const interval = 60000 / bpm;
        let step = 0;
        
        SoundEngine.beatInterval = setInterval(() => {
            if (SoundEngine.muted || !SoundEngine.ctx) return;
            if (step % 4 === 0) {
                SoundEngine.playTone(150, 'sine', 0.1, 0.5); 
                SoundEngine.playTone(50, 'square', 0.1, 0.3);
            }
            if (step % 4 === 2) SoundEngine.playNoise(0.1, 0.3);
            if (step % 2 === 0) SoundEngine.playTone(8000, 'square', 0.05, 0.05);
            if (step % 4 === 2) {
                 SoundEngine.playTone(440, 'triangle', 0.1, 0.1);
                 SoundEngine.playTone(523, 'triangle', 0.1, 0.1);
                 SoundEngine.playTone(659, 'triangle', 0.1, 0.1);
            }
            step++;
        }, interval / 4);
    },

    stopBeat: () => {
        if (SoundEngine.beatInterval) {
            clearInterval(SoundEngine.beatInterval);
            SoundEngine.beatInterval = null;
        }
    },

    click: () => SoundEngine.playTone(600, 'sine', 0.1, 0.1),
    tick: () => SoundEngine.playTone(800, 'square', 0.05, 0.05),
    tock: () => SoundEngine.playTone(600, 'square', 0.05, 0.05),
    win: () => {
        const now = 0;
        SoundEngine.playTone(523.25, 'triangle', 0.2, 0.3, now);
        SoundEngine.playTone(523.25, 'triangle', 0.2, 0.3, now + 0.1);
        SoundEngine.playTone(523.25, 'triangle', 0.2, 0.3, now + 0.2);
        SoundEngine.playTone(659.25, 'triangle', 0.6, 0.3, now + 0.3);
        SoundEngine.playTone(783.99, 'triangle', 0.6, 0.3, now + 0.6);
        SoundEngine.playTone(1046.50, 'triangle', 1.0, 0.4, now + 0.9);
        setTimeout(() => SoundEngine.playNoise(0.5, 0.2), 500);
        setTimeout(() => SoundEngine.playNoise(0.5, 0.2), 800);
        setTimeout(() => SoundEngine.playNoise(0.5, 0.2), 1200);
    },
    fail: () => {
        if (SoundEngine.muted || !SoundEngine.ctx) return;
        const osc = SoundEngine.ctx.createOscillator();
        const gain = SoundEngine.ctx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(150, SoundEngine.ctx.currentTime);
        osc.frequency.linearRampToValueAtTime(50, SoundEngine.ctx.currentTime + 0.5);
        gain.gain.setValueAtTime(0.3, SoundEngine.ctx.currentTime);
        gain.gain.linearRampToValueAtTime(0.01, SoundEngine.ctx.currentTime + 0.5);
        osc.connect(gain);
        gain.connect(SoundEngine.ctx.destination);
        osc.start();
        osc.stop(SoundEngine.ctx.currentTime + 0.5);
    },
    crash: () => {
        SoundEngine.playNoise(0.8, 0.4); 
        SoundEngine.playTone(100, 'sawtooth', 0.5, 0.3);
    },
    spin: () => {
        let count = 0;
        const interval = setInterval(() => {
            SoundEngine.playTone(400 + Math.random() * 200, 'square', 0.03, 0.05);
            count++;
            if (count > 20) clearInterval(interval);
        }, 100);
    },
    buzzer: () => {
        SoundEngine.stopBeat();
        SoundEngine.playTone(150, 'sawtooth', 0.4, 0.3);
        setTimeout(() => SoundEngine.playTone(100, 'sawtooth', 0.4, 0.3), 100);
    },
    alarm: () => {
        let count = 0;
        const interval = setInterval(() => {
            SoundEngine.playTone(800, 'sawtooth', 0.1, 0.3);
            count++;
            if (count > 5) clearInterval(interval);
        }, 200);
    }
};

