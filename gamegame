}

// --- SUB-COMPONENTS ---

const RouletteView = ({ onFinish }) => {
    const [rotation, setRotation] = useState(0);

    useEffect(() => {
        const isRed = Math.random() > 0.5;
        const baseSpins = 1440; 
        const winnerOffset = isRed ? 0 : 180;
        
        // Slightly reduced jitter to ensure clear sector landing
        const jitter = Math.floor(Math.random() * 20) - 10; 
        
        const targetRotation = baseSpins + winnerOffset + jitter;

        const spinTimer = setTimeout(() => {
            setRotation(targetRotation);
        }, 100);

        const finishTimer = setTimeout(() => {
            onFinish(isRed ? 'red' : 'blue');
        }, 4500);

        return () => {
            clearTimeout(spinTimer);
            clearTimeout(finishTimer);
        };
    }, [onFinish]);

    return (
        <div className="min-h-[100dvh] flex flex-col items-center justify-center overflow-hidden text-white">
            <h2 className="text-4xl font-display mb-12 animate-pulse text-yellow-400 drop-shadow-lg tracking-widest">
                WER FÄNGT AN?
            </h2>
            <div className="relative w-64 h-64 sm:w-80 sm:h-80">
                <div className="absolute -top-8 left-1/2 transform -translate-x-1/2 z-20 w-0 h-0 border-l-[25px] border-l-transparent border-r-[25px] border-r-transparent border-t-[50px] border-t-yellow-400 drop-shadow-2xl"></div>
                <div 
                    className="roulette-wheel w-full h-full rounded-full overflow-hidden border-[12px] border-white/20 shadow-[0_0_80px_rgba(255,255,255,0.3)] relative bg-white"
                    style={{ transform: `rotate(${rotation}deg)` }}
                >
                    <div className="absolute top-0 left-0 w-full h-1/2 bg-red-600 flex items-center justify-center pt-10 border-b-4 border-black/10">
                        <span className="transform rotate-180 font-display text-5xl text-red-900/50">ROT</span>
                    </div>
                    <div className="absolute bottom-0 left-0 w-full h-1/2 bg-blue-600 flex items-center justify-center pb-10 border-t-4 border-black/10">
                        <span className="font-display text-5xl text-blue-900/50">BLAU</span>
                    </div>
                </div>
            </div>
        </div>
    );
};

