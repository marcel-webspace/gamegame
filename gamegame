const ChartQuizGame = ({ game, onResult }) => {
    const [round, setRound] = useState(1);
    const [scores, setScores] = useState({ red: 0, blue: 0 });
    const [currentSong, setCurrentSong] = useState(null);
    const [buzzerPressedBy, setBuzzerPressedBy] = useState(null); 
    const [showSolution, setShowSolution] = useState(false);
    const [phase, setPhase] = useState('ready'); 

    const getNewSong = () => {
        return CHART_SONGS[Math.floor(Math.random() * CHART_SONGS.length)];
    };

    useEffect(() => {
        startRound();
        return () => {
            SoundEngine.stopBeat(); 
        };
    }, []);

    const startRound = () => {
        setBuzzerPressedBy(null);
        setShowSolution(false);
        setPhase('ready');
        setCurrentSong(getNewSong());
        SoundEngine.startBeat(125); 
    };

    const handleBuzzer = (team) => {
        if (phase !== 'ready') return;
        SoundEngine.buzzer(); 
        setBuzzerPressedBy(team);
        setPhase('buzzed');
    };

    const resolveRound = (correct) => {
        let winner = null;
        if (correct) {
            winner = buzzerPressedBy;
            setScores(s => ({ ...s, [buzzerPressedBy]: s[buzzerPressedBy] + 1 }));
            SoundEngine.win(); 
        } else {
            winner = buzzerPressedBy === 'red' ? 'blue' : 'red';
            setScores(s => ({ ...s, [winner]: s[winner] + 1 }));
            SoundEngine.fail();
        }

        setTimeout(() => {
            if (round >= 5) {
                setPhase('game_over');
            } else {
                setRound(r => r + 1);
                startRound();
            }
        }, 3000);
    };

