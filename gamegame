// --- TIME STOPPER (ID 1) ---
const TimeStopGame = ({ game, onResult }) => {
    const [round, setRound] = useState(1);
    const [targetTime, setTargetTime] = useState(5.00); 
    const [phase, setPhase] = useState('ready'); 
    const [scores, setScores] = useState({ red: 0, blue: 0 });
    const [roundHistory, setRoundHistory] = useState([]); 
    const [matchWinner, setMatchWinner] = useState(null);
    const startTimeRef = useRef(null);
    const animationFrameRef = useRef(null);
    const [redTime, setRedTime] = useState(null);
    const [blueTime, setBlueTime] = useState(null);
    const [displayTime, setDisplayTime] = useState("00:00");

    useEffect(() => {
        startNewRound();
        return () => cancelAnimationFrame(animationFrameRef.current);
    }, []);

    const startNewRound = () => {
        const newTarget = (Math.random() * 9 + 1).toFixed(2);
        setTargetTime(newTarget);
        setRedTime(null);
        setBlueTime(null);
        setDisplayTime("00:00");
        setPhase('ready');
    };

    const startTimer = () => {
        SoundEngine.click();
        setPhase('running');
        startTimeRef.current = Date.now();
        const loop = () => {
            const now = Date.now();
            const delta = now - startTimeRef.current;
            const seconds = Math.floor(delta / 1000);
            const ms = Math.floor((delta % 1000) / 10);
            setDisplayTime(`${seconds.toString().padStart(2, '0')}:${ms.toString().padStart(2, '0')}`);
            if (redTime === null || blueTime === null) {
                animationFrameRef.current = requestAnimationFrame(loop);
            }
        };
        loop();
    };

    const handleStop = (team) => {
        if (phase !== 'running') return;
        SoundEngine.click();
        const stopTime = Date.now() - startTimeRef.current;
        const stopTimeSec = stopTime / 1000;
        if (team === 'red' && redTime === null) setRedTime(stopTimeSec);
        if (team === 'blue' && blueTime === null) setBlueTime(stopTimeSec);
    };

    useEffect(() => {
        if (redTime !== null && blueTime !== null && phase === 'running') {
            cancelAnimationFrame(animationFrameRef.current);
            evaluateRound();
        }
    }, [redTime, blueTime, phase]);

    const evaluateRound = () => {
        setPhase('result');
        SoundEngine.win();
        const targetSec = parseFloat(targetTime);
        const redDiff = Math.abs(redTime - targetSec);
        const blueDiff = Math.abs(blueTime - targetSec);
        let winner = 'draw';
        if (redDiff < blueDiff) winner = 'red';
        else if (blueDiff < redDiff) winner = 'blue';
        
        const newHistory = [...roundHistory, winner];
        setRoundHistory(newHistory);
        const nextScores = { ...scores };
        if (winner === 'red') nextScores.red += 1;
        if (winner === 'blue') nextScores.blue += 1;
        setScores(nextScores);

        setTimeout(() => {
            if (round >= 3) {
                if (nextScores.red !== nextScores.blue) {
                    setMatchWinner(nextScores.red > nextScores.blue ? 'red' : 'blue');
                    SoundEngine.matchWin();
                    setPhase('match_over');
                    return;
                }
            }
            setRound(r => r + 1);
            startNewRound();
        }, 4000);
    };

    if (phase === 'match_over') {
        return (
            <div className="min-h-[100dvh] flex flex-col items-center justify-center bg-black/80 text-center p-4 animate-in fade-in">
                <Trophy size={100} className={`mb-8 sm:w-30 sm:h-30 ${matchWinner === 'red' ? 'text-red-500' : 'text-blue-500'}`} />
                <h2 className="text-5xl sm:text-6xl font-display text-white mb-4">GEWINNER</h2>
                <h3 className={`text-6xl sm:text-8xl font-display mb-12 ${matchWinner === 'red' ? 'text-red-500' : 'text-blue-500'}`}>
                    TEAM {matchWinner === 'red' ? 'ROT' : 'BLAU'}
                </h3>
                <button onClick={() => onResult(true)} className="btn-press bg-white text-black font-bold py-4 px-12 rounded-full text-xl flex items-center gap-2">
                    WEITER ZUM HUB
                </button>
            </div>
        );
    }

    return (
        <div className="min-h-[100dvh] flex flex-col relative bg-slate-900">
            <div className="flex-1 bg-red-900/20 border-b-2 border-white/10 relative flex flex-col items-center justify-center transform rotate-180 p-4 transition-colors duration-300"
                 style={{ backgroundColor: phase === 'result' && roundHistory[round-1] === 'red' ? 'rgba(220, 38, 38, 0.4)' : '' }}>
                <div className="absolute top-4 left-4 flex gap-2 rotate-180">
                   {roundHistory.map((w, i) => (
                       <div key={i} className={`w-3 h-3 sm:w-4 sm:h-4 rounded-full border border-black/50 ${w === 'red' ? 'bg-yellow-400 shadow-[0_0_10px_yellow]' : 'bg-slate-700'}`}></div>
                   ))}
                </div>
                <h3 className="text-red-400 font-display text-3xl sm:text-4xl mb-4">TEAM ROT</h3>
                <div className="text-5xl sm:text-6xl font-mono mb-6 text-white font-bold">{redTime ? redTime.toFixed(3) : displayTime} s</div>
                <button onMouseDown={() => handleStop('red')} onTouchStart={() => handleStop('red')} disabled={phase !== 'running' || redTime !== null} className={`w-28 h-28 sm:w-40 sm:h-40 rounded-full border-8 shadow-[0_0_30px_rgba(220,38,38,0.5)] flex items-center justify-center transition-all ${phase === 'running' && redTime === null ? 'bg-red-600 border-red-400 active:scale-95' : 'bg-slate-700 border-slate-600 grayscale'}`}>
                    <span className="font-display text-2xl sm:text-3xl text-white">STOP</span>
                </button>
            </div>
            <div className="h-24 bg-black flex items-center justify-center z-10 border-y-4 border-yellow-500/50 relative shadow-2xl">
                <div className="flex flex-col items-center w-full">
                    <div className="text-yellow-500 font-bold uppercase text-xs tracking-[0.2em] mb-1">RUNDE {round} {round > 3 && "(SUDDEN DEATH)"}</div>
                    <div className="text-white font-mono text-3xl font-bold bg-slate-900 border border-white/20 px-6 py-1 rounded-lg">ZIEL: <span className="text-yellow-500">{targetTime}</span> s</div>
                </div>
                {phase === 'ready' && (
                    <button onClick={startTimer} className="absolute inset-0 bg-green-500 hover:bg-green-400 text-black font-display text-3xl sm:text-4xl tracking-widest flex items-center justify-center z-20 animate-pulse-fast transition-colors">STARTEN</button>
                )}
            </div>
            <div className="flex-1 bg-blue-900/20 border-t-2 border-white/10 relative flex flex-col items-center justify-center p-4 transition-colors duration-300"
                 style={{ backgroundColor: phase === 'result' && roundHistory[round-1] === 'blue' ? 'rgba(37, 99, 235, 0.4)' : '' }}>
                 <div className="absolute top-4 left-4 flex gap-2">
                   {roundHistory.map((w, i) => (
                       <div key={i} className={`w-3 h-3 sm:w-4 sm:h-4 rounded-full border border-black/50 ${w === 'blue' ? 'bg-yellow-400 shadow-[0_0_10px_yellow]' : 'bg-slate-700'}`}></div>
                   ))}
                </div>
                <h3 className="text-blue-400 font-display text-3xl sm:text-4xl mb-4">TEAM BLAU</h3>
                <div className="text-5xl sm:text-6xl font-mono mb-6 text-white font-bold">{blueTime ? blueTime.toFixed(3) : displayTime} s</div>
                <button onMouseDown={() => handleStop('blue')} onTouchStart={() => handleStop('blue')} disabled={phase !== 'running' || blueTime !== null} className={`w-28 h-28 sm:w-40 sm:h-40 rounded-full border-8 shadow-[0_0_30px_rgba(37,99,235,0.5)] flex items-center justify-center transition-all ${phase === 'running' && blueTime === null ? 'bg-blue-600 border-blue-400 active:scale-95' : 'bg-slate-700 border-slate-600 grayscale'}`}>
                    <span className="font-display text-2xl sm:text-3xl text-white">STOP</span>
                </button>
            </div>
            {phase === 'result' && (
                <div className="absolute inset-0 bg-black/60 flex items-center justify-center z-50 backdrop-blur-sm animate-in fade-in">
                    <div className="bg-slate-800 p-6 sm:p-8 rounded-2xl border-2 border-yellow-500 text-center shadow-2xl">
                        <h2 className="text-2xl sm:text-3xl font-display text-white mb-2">RUNDE BEENDET</h2>
                        <div className="mb-4 text-slate-300">Ziel: {targetTime}s</div>
                        <div className="grid grid-cols-2 gap-4 sm:gap-8 mb-6">
                            <div className={`${Math.abs(redTime - targetTime) < Math.abs(blueTime - targetTime) ? 'text-green-400' : 'text-red-400'} font-bold`}>ROT<br/>{redTime.toFixed(3)}s<br/><span className="text-xs text-slate-500">Diff: {Math.abs(redTime - targetTime).toFixed(3)}</span></div>
                            <div className={`${Math.abs(blueTime - targetTime) < Math.abs(redTime - targetTime) ? 'text-green-400' : 'text-red-400'} font-bold`}>BLAU<br/>{blueTime.toFixed(3)}s<br/><span className="text-xs text-slate-500">Diff: {Math.abs(blueTime - targetTime).toFixed(3)}</span></div>
                        </div>
                        <div className="text-yellow-400 font-bold animate-pulse text-sm sm:text-base">Nächste Runde in Kürze...</div>
                    </div>
                </div>
            )}
        </div>
    );
};