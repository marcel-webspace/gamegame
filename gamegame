// --- APP COMPONENT ---
export default function App() {
    const [gameState, setGameState] = useState('landing');
    const [teams, setTeams] = useState({ red: [], blue: [] });
    const [activeGame, setActiveGame] = useState(null);
    const [activeTeam, setActiveTeam] = useState(null); 
    const [tempRed, setTempRed] = useState("");
    const [tempBlue, setTempBlue] = useState("");
    const [muted, setMuted] = useState(false);
    
    const [showConfetti, setShowConfetti] = useState(false);
    const [showFireworks, setShowFireworks] = useState(false);
    const [showBlackout, setShowBlackout] = useState(false);
    const [showSkipAlert, setShowSkipAlert] = useState(false);
    const [punishmentType, setPunishmentType] = useState('standard');

    const handleStart = () => {
        SoundEngine.init();
        SoundEngine.click();
        setGameState('setup');
    };

    const toggleMute = () => {
        SoundEngine.muted = !SoundEngine.muted;
        setMuted(SoundEngine.muted);
    };

    const playClick = () => SoundEngine.click();

    const addPlayer = (team) => {
        const nameRaw = team === 'red' ? tempRed : tempBlue;
        const name = nameRaw.trim();
        if (!name) return;
        if (teams.red.includes(name) || teams.blue.includes(name)) return;

        playClick();
        setTeams(prev => ({
            ...prev,
            [team]: [...prev[team], name]
        }));
        if (team === 'red') setTempRed("");
        else setTempBlue("");
    };

    const selectRandomGame = (overrideId = null) => {
        playClick();
        let randomGame;
        if (overrideId) {
             randomGame = MINI_GAMES.find(g => g.id === overrideId) || MINI_GAMES[0];
        } else {
             randomGame = MINI_GAMES[Math.floor(Math.random() * MINI_GAMES.length)];
        }
        
        setActiveGame(randomGame);
        
        if (randomGame.mode === 'versus') {
            setActiveTeam('both');
            SoundEngine.crash();
            setGameState('versus_transition');
        } else {
            SoundEngine.spin();
            setGameState('roulette');
        }
    };

